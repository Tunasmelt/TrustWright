        "text"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000
      },
      "maxItems": 500
    },
    "discovery_gaps": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "reason",
          "scope_ref",
          "display"
        ],
        "additionalProperties": false,
        "properties": {
          "reason": {
            "enum": [
              "endpoint_not_declared",
              "source_parse_error",
              "unsupported_route_form",
              "unresolved_import",
              "unresolved_prefix",
              "unresolved_dynamic_route",
              "binding_unresolved"
            ]
          },
          "scope_ref": {
            "type": "string",
            "maxLength": 128
          },
          "display": {
            "type": "object",
            "required": [
              "outcome",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "outcome": {
                "const": "unknown"
              },
              "status": {
                "enum": [
                  "intent_missing",
                  "not_assessed"
                ]
              }
            }
          },
          "python_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+[A-Za-z0-9+.]*$",
            "maxLength": 32
          }
        },
        "if": {
          "properties": {
            "reason": {
              "const": "source_parse_error"
            }
          }
        },
        "then": {
          "required": [
            "python_version"
          ]
        }
      }
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "assessment_inputs",
    "current",
    "historical",
    "coverage_gaps",
    "unknowns",
    "response_assumptions",
    "untrusted_text",
    "limitations",
    "discovery_gaps"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report.schema.json",
  "title": "M1a report",
  "description": "Current entries require exact assessment-input equality. Historical evidence never becomes current by relabeling. No score; no-match is coverage only. Public finding projections use opaque workspace references; validate the original finding before projection.",
  "$defs": {
    "finding": {
      "title": "Finding (evidence and assessment)",
      "description": "What was observed, how it was checked, and what conclusion it supports. The display label is derived from result, method, evidence, and server-owned trust records; the stored copy is checked by the validator.",
      "type": "object",
      "required": [
        "id",
        "control_id",
        "intent_ref",
        "scope",
        "result",
        "method",
        "evidence",
        "display",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F-[0-9]{3,}$"
        },
        "control_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "intent_ref": {
          "description": "Required for endpoint-scoped controls; null for codebase-scoped controls.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "endpoint_id",
                "requirement_id"
              ],
              "additionalProperties": false,
              "properties": {
                "endpoint_id": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
                  "maxLength": 512
                },
                "requirement_id": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
                  "maxLength": 512
                }
              }
            }
          ]
        },
        "scope": {
          "type": "object",
          "required": [
            "kind",
            "ref"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "endpoint",
                "function",
                "configuration",
                "dependency",
                "test_scenario",
                "codebase"
              ]
            },
            "ref": {
              "type": "string",
              "description": "What exactly this finding covers. A finding never speaks beyond its scope.",
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
              "maxLength": 512
            },
            "locations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/finding/$defs/location"
              }
            }
          }
        },
        "result": {
          "enum": [
            "violated",
            "satisfied",
            "unknown",
            "not_applicable"
          ]
        },
        "method": {
          "enum": [
            "static_rule",
            "structural_check",
            "dependency_advisory",
            "agent_review",
            "behavioral_test",
            "human_review",
            "intent_review",
            "not_assessed"
          ]
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding/$defs/evidence"
          },
          "minItems": 1
        },
        "display": {
          "type": "object",
          "required": [
            "outcome",
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "enum": [
                "issue_found",
                "check_passed",
                "test_passed",
                "needs_review",
                "unknown"
              ]
            },
            "status": {
              "enum": [
                "confirmed",
                "reproduced",
                "reported",
                "pattern_matched",
                "structurally_linked",
                "not_linked",
                "agent_assessed",
                "intent_missing",
                "version_unresolved",
                "human_reviewed",
                "not_assessed"
              ]
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$",
            "maxLength": 4000
          },
          "description": "What this finding does NOT establish. Required to be non-empty for anything other than a confirmed issue (enforced by the validator)."
        },
        "recipe_ref": {
          "type": "object",
          "required": [
            "pack_id",
            "recipe_id"
          ],
          "additionalProperties": false,
          "properties": {
            "pack_id": {
              "type": "string",
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
              "maxLength": 512
            },
            "recipe_id": {
              "type": "string",
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
              "maxLength": 512
            }
          }
        }
      },
      "allOf": [
        {
          "description": "Only behavioral tests and human review can establish that a requirement is satisfied.",
          "if": {
            "properties": {
              "result": {
                "const": "satisfied"
              }
            }
          },
          "then": {
            "properties": {
              "method": {
                "enum": [
                  "behavioral_test",
                  "human_review"
                ]
              }
            }
          }
        },
        {
          "description": "A static rule establishes a violation (specific-violation checks) or flags for review (suspicious-pattern checks). A non-match produces no finding.",
          "if": {
            "properties": {
              "method": {
                "const": "static_rule"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "enum": [
                  "violated",
                  "unknown"
                ]
              }
            }
          }
        },
        {
          "description": "A structural link is a connection, not proof of protection; its absence is not proof of a violation.",
          "if": {
            "properties": {
              "method": {
                "const": "structural_check"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "const": "unknown"
              }
            }
          }
        },
        {
          "description": "An agent's interpretation is always displayed as agent-assessed, whatever it concluded.",
          "if": {
            "properties": {
              "method": {
                "const": "agent_review"
              }
            }
          },
          "then": {
            "properties": {
              "display": {
                "properties": {
                  "status": {
                    "const": "agent_assessed"
                  }
                }
              }
            }
          }
        },
        {
          "description": "An advisory either applies to a resolved version or the version could not be resolved.",
          "if": {
            "properties": {
              "method": {
                "const": "dependency_advisory"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "enum": [
                  "violated",
                  "unknown"
                ]
              }
            }
          }
        },
        {
          "description": "A missing or unconfirmed intent can only ever produce Unknown.",
          "if": {
            "properties": {
              "method": {
                "const": "intent_review"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "const": "unknown"
              },
              "display": {
                "properties": {
                  "status": {
                    "const": "intent_missing"
                  }
                }
              }
            }
          }
        },
        {
          "description": "A confirmed requirement that no check could assess can only ever produce Unknown.",
          "if": {
            "properties": {
              "method": {
                "const": "not_assessed"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "const": "unknown"
              },
              "display": {
                "properties": {
                  "status": {
                    "const": "not_assessed"
                  }
                }
              }
            }
          }
        },
        {
          "description": "static_rule findings cite rule_match evidence, and only that.",
          "if": {
            "properties": {
              "method": {
                "const": "static_rule"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "items": {
                  "properties": {
                    "type": {
                      "const": "rule_match"
                    }
                  }
                },
                "contains": {
                  "properties": {
                    "type": {
                      "const": "rule_match"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "description": "structural_check findings cite structural_link evidence, and only that.",
          "if": {
            "properties": {
              "method": {
                "const": "structural_check"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "items": {
                  "properties": {
                    "type": {
                      "const": "structural_link"
                    },
                    "binding_source": {
                      "enum": [
                        "static_discovery",
                        "agent_supplied",
                        "legacy_unspecified"
                      ]
                    },
                    "authentication_semantics": {
                      "const": "unverified"
                    }
                  }
                },
                "contains": {
                  "properties": {
                    "type": {
                      "const": "structural_link"
                    },
                    "binding_source": {
                      "enum": [
                        "static_discovery",
                        "agent_supplied",
                        "legacy_unspecified"
                      ]
                    },
                    "authentication_semantics": {
                      "const": "unverified"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "description": "dependency_advisory findings cite advisory evidence, and only that.",
          "if": {
            "properties": {
              "method": {
                "const": "dependency_advisory"
              }
            }
          },
          "then": {
