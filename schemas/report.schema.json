    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding": {
            "$ref": "#/$defs/finding"
          },
          "untrusted_text": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "maxLength": 4000
              },
