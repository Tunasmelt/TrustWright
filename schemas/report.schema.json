                }
              ]
            },
            "status": {
              "enum": [
                "available",
                "unavailable"
              ]
            }
          },
          "required": [
            "name",
            "version",
            "digest",
            "status"
          ],
          "additionalProperties": false
        },
        "advisory": {
          "type": "object",
          "properties": {
            "status": {
              "const": "not_queried"
            },
            "checked_at": {
              "type": "null"
            }
          },
          "required": [
            "status",
            "checked_at"
          ],
          "additionalProperties": false
        },
        "scope": {
          "type": "string",
          "maxLength": 4000
        },
        "check_configuration_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "workspace_id",
        "code_digest",
        "intent_digest",
        "confirmation_digest",
        "packs_digest",
        "dependencies_digest",
        "configuration_digest",
        "engine",
        "advisory",
        "scope",
        "check_configuration_digest"
      ],
      "additionalProperties": false
    },
    "current": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assessment_id": {
            "type": "string",
            "maxLength": 4000
          },
          "created_at": {
            "type": "string",
