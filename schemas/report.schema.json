      ],
      "$defs": {
        "location": {
          "type": "object",
          "required": [
            "path",
            "start_line"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 1024,
              "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$))[^\\u0000]+$",
              "description": "Workspace-relative path. No leading slash, drive letter, or '..' segment: the server reads cited lines, and must never be pointed outside the workspace."
            },
            "start_line": {
              "type": "integer",
              "minimum": 1
            },
            "end_line": {
              "type": "integer",
              "minimum": 1
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "Hash of the cited lines, so stale citations are detectable."
            }
          }
        },
        "validation": {
          "enum": [
            "unchecked",
            "source_matched",
            "rule_matched",
            "structurally_linked",
            "not_linked",
            "reported",
            "independently_reproduced",
            "advisory_matched",
            "attested"
          ]
        },
        "evidence": {
          "oneOf": [
            {
              "title": "Pack static rule matched",
              "type": "object",
              "required": [
                "type",
                "validation",
                "pack_id",
                "check_id",
                "location"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "rule_match"
                },
                "validation": {
                  "const": "rule_matched"
                },
                "pack_id": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
                  "maxLength": 512
                },
                "check_id": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
                  "maxLength": 512
                },
                "location": {
                  "$ref": "#/$defs/finding/$defs/location"
                }
              }
            },
            {
              "title": "Pack-defined structural check (never agent-authored)",
              "type": "object",
              "required": [
                "type",
                "validation",
                "pack_id",
                "check_id",
                "params"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "structural_link"
                },
                "validation": {
                  "enum": [
                    "structurally_linked",
                    "not_linked"
                  ]
                },
                "pack_id": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
                  "maxLength": 512
                },
                "check_id": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
                  "maxLength": 512
                },
                "params": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
                    "maxLength": 512
                  }
                },
                "location": {
                  "$ref": "#/$defs/finding/$defs/location"
                },
                "binding_source": {
                  "enum": [
                    "static_discovery",
                    "agent_supplied",
                    "legacy_unspecified"
                  ]
                },
                "authentication_semantics": {
                  "const": "unverified"
                }
              }
            },
            {
              "title": "Agent citation",
              "type": "object",
              "required": [
                "type",
                "validation",
                "claim",
                "location"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "agent_citation"
                },
                "validation": {
                  "enum": [
                    "unchecked",
                    "source_matched"
                  ]
                },
                "claim": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$",
                  "maxLength": 4000
                },
                "location": {
                  "$ref": "#/$defs/finding/$defs/location"
                }
              }
            },
            {
              "title": "Dependency advisory",
              "type": "object",
              "required": [
                "type",
                "validation",
                "ecosystem",
                "package",
                "version_source"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "advisory"
                },
                "validation": {
                  "enum": [
                    "advisory_matched",
                    "unchecked"
                  ]
                },
                "ecosystem": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
                  "maxLength": 512
                },
                "package": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
                  "maxLength": 512
                },
                "version": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
                  "maxLength": 512
                },
                "version_source": {
                  "enum": [
                    "lockfile",
                    "environment",
                    "pinned_manifest",
                    "unpinned_manifest"
                  ]
                },
                "advisory_id": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
                  "maxLength": 512
                }
              },
              "allOf": [
                {
                  "description": "A matched advisory must name the resolved version and the advisory.",
                  "if": {
                    "properties": {
                      "validation": {
                        "const": "advisory_matched"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "version",
                      "advisory_id"
                    ],
                    "properties": {
                      "version": {
                        "minLength": 1
                      },
                      "advisory_id": {
                        "minLength": 1
                      }
                    }
                  }
                }
              ]
            },
            {
              "title": "Verification run",
              "type": "object",
              "required": [
                "type",
                "validation",
                "run_id",
                "scenario_ids"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "verification_run"
                },
                "validation": {
                  "enum": [
                    "reported",
                    "independently_reproduced"
                  ]
                },
                "run_id": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
                  "maxLength": 512
                },
                "scenario_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
                    "maxLength": 512
                  }
                }
              }
            },
            {
              "title": "Intent gap",
              "type": "object",
              "required": [
                "type",
                "validation",
                "reason"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "intent_gap"
                },
                "validation": {
                  "const": "unchecked"
                },
                "reason": {
                  "enum": [
                    "policy_unknown",
                    "policy_inferred_not_confirmed",
                    "endpoint_not_declared"
                  ]
                }
              }
            },
            {
              "title": "Assessment gap (confirmed requirement that no check assessed)",
              "type": "object",
              "required": [
                "type",
                "validation",
                "reason"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "assessment_gap"
                },
                "validation": {
                  "const": "unchecked"
                },
                "reason": {
                  "enum": [
                    "not_assessed:route_not_resolved",
                    "not_assessed:dependency_binding_unresolved",
                    "not_assessed:no_applicable_check",
                    "not_assessed:check_not_run",
                    "not_assessed:no_current_assessment"
                  ]
                }
              }
            },
            {
              "title": "Human attestation (must also exist in the server-owned trust ledger)",
              "type": "object",
              "required": [
                "type",
                "validation",
                "attestation_id",
                "reviewer",
                "reviewed_tree_digest"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "human_attestation"
                },
                "validation": {
                  "const": "attested"
                },
                "attestation_id": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
                  "maxLength": 512
                },
                "reviewer": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
                  "maxLength": 512
                },
                "reviewed_tree_digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          ]
        }
      }
    }
  }
}
