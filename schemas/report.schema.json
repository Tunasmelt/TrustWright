                "pattern": "^[a-f0-9]{64}$"
              },
              "configuration_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "engine": {
                "type": "object",
                "properties": {
                  "name": {
                    "const": "opengrep"
                  },
                  "version": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "digest": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "status": {
                    "enum": [
                      "available",
                      "unavailable"
                    ]
                  }
                },
                "required": [
                  "name",
                  "version",
