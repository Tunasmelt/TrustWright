              "intent_digest",
              "confirmation_digest",
              "packs_digest",
              "dependencies_digest",
              "configuration_digest",
              "engine",
              "advisory",
              "scope",
              "check_configuration_digest"
            ],
            "additionalProperties": false
          },
          "findings": {
            "type": "array",
