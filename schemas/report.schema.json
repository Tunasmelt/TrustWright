                    "text"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "finding",
                "untrusted_text"
              ],
              "additionalProperties": false
            },
            "maxItems": 500
          },
          "coverage": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "check_id": {
                  "type": "string",
                  "maxLength": 4000
                },
                "status": {
                  "enum": [
                    "completed",
