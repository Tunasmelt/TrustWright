      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000
      },
      "maxItems": 500
    },
    "untrusted_text": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "maxLength": 4000
        },
        "text": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
