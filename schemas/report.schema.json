                  "status"
                ],
                "additionalProperties": false
              },
              "advisory": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "not_queried"
                  },
                  "checked_at": {
                    "type": "null"
                  }
                },
                "required": [
                  "status",
                  "checked_at"
                ],
                "additionalProperties": false
              },
              "scope": {
                "type": "string",
                "maxLength": 4000
              },
              "check_configuration_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "workspace_id",
              "code_digest",
              "intent_digest",
              "confirmation_digest",
              "packs_digest",
              "dependencies_digest",
              "configuration_digest",
              "engine",
              "advisory",
              "scope",
              "check_configuration_digest"
            ],
            "additionalProperties": false
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "finding": {
                  "$ref": "#/$defs/finding"
                },
                "untrusted_text": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "maxLength": 4000
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 4000
                    }
                  },
                  "required": [
                    "source",
                    "text"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "finding",
                "untrusted_text"
              ],
              "additionalProperties": false
            },
            "maxItems": 500
          },
          "coverage": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "check_id": {
                  "type": "string",
                  "maxLength": 4000
                },
                "status": {
                  "enum": [
                    "completed",
                    "not_run",
                    "error"
                  ]
                },
                "reason": {
                  "type": "string",
                  "maxLength": 4000
                },
                "matches": {
                  "type": "integer",
                  "minimum": 0
                },
                "endpoint_ref": {
                  "type": "string",
                  "pattern": "^ref-[a-f0-9]{20}$"
                },
                "requirement_ref": {
                  "type": "string",
                  "pattern": "^ref-[a-f0-9]{20}$"
                }
              },
              "required": [
                "check_id",
                "status",
                "reason",
                "matches"
              ],
              "additionalProperties": false
            },
            "maxItems": 500
          }
        },
        "required": [
          "assessment_id",
          "created_at",
          "inputs",
          "findings",
          "coverage"
        ],
        "additionalProperties": false
      },
