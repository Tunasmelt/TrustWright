            }
          },
          "then": {
            "properties": {
              "evidence": {
                "items": {
                  "properties": {
                    "type": {
                      "const": "verification_run"
                    }
                  }
                },
                "contains": {
                  "properties": {
                    "type": {
                      "const": "verification_run"
