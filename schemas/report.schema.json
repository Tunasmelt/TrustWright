{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.5.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "assessment_inputs": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string",
