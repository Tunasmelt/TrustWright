          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "packs_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dependencies_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configuration_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "engine": {
          "type": "object",
          "properties": {
            "name": {
              "const": "opengrep"
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            },
            "digest": {
              "anyOf": [
