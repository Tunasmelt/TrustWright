          },
          "then": {
            "properties": {
              "evidence": {
                "items": {
                  "properties": {
                    "type": {
                      "const": "human_attestation"
                    }
                  }
                },
                "contains": {
                  "properties": {
                    "type": {
                      "const": "human_attestation"
                    }
